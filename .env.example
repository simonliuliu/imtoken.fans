# 复制这个文件为 .env.local，并把下面的值换成你自己的（获取方式见 README）

# --- Supabase（数据库 / 认证 / 存储） ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key 权限极高，只能用在服务端（比如管理后台的服务端逻辑），千万不要加 NEXT_PUBLIC_ 前缀，也不要出现在浏览器代码里
SUPABASE_SERVICE_ROLE_KEY=

# --- 仅本地开发的一键登录（生产环境保持关闭） ---
# 先启动本地 Supabase，再运行 npm run setup:dev-auth 自动准备三个测试账号和随机密码。
LOCAL_DEV_AUTH_ENABLED=false
LOCAL_DEV_AUTH_PASSWORD=

# --- Google OAuth（登录用，实际会配置在 Supabase Auth 后台，这里备份一份方便你查） ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Web3 钱包登录 ---
# 浏览器注入式钱包（MetaMask / imToken 内置浏览器）登录不需要 Reown，只需要下面这个密钥：
# 用来给登录用的签名验证码防篡改，运行 `openssl rand -base64 32` 生成一个随机值即可
WALLET_AUTH_SECRET=
# 手机扫码连接（WalletConnect）才需要，去 https://cloud.reown.com 创建项目后填这里，P1 阶段可以先留空
NEXT_PUBLIC_REOWN_PROJECT_ID=

# --- 站点地址（可选） ---
# 生产环境建议填真实域名（比如 https://imaihunt.vercel.app），用来拼登录跳转链接；
# 本地开发和大多数部署环境不填也能自动识别，只有反向代理场景识别不准时才需要手动填
NEXT_PUBLIC_SITE_URL=

# --- AI 内容审核（提交/评论的审核方式在 /admin 后台可以切换成"AI 审核"） ---
# 填一个 Anthropic API key，管理后台的"AI 审核"选项才会可选；不填的话该选项自动置灰，
# 已经选成 AI 审核的内容会自动退回人工队列，不影响正常使用
AI_MODERATION_API_KEY=
# 不填默认用 Anthropic 官方接口，一般不需要改
AI_MODERATION_API_URL=
# 不填默认用 claude-haiku-4-5（便宜、够用），审核标准写在 src/lib/moderation/prompts/ 下的文件里
AI_MODERATION_MODEL=
